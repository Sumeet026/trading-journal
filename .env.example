# Server-side only. NEVER add a VITE_ prefix to these keys -
# VITE_ variables are embedded into the browser bundle and would expose the key.

# Google AI Studio / Gemini API key used for screenshot -> trades extraction.
MT5_AI_API_KEY=your_gemini_api_key_here

# Optional: model override (default: gemini-3.8-flash)
MT5_AI_MODEL=gemini-3.8-flash

# Optional: set to true to require a signed-in user for AI extraction
MT5_ENFORCE_AUTH=false

# Optional: comma-separated origins allowed to call /api/extract-trades (empty = allow all)
ALLOWED_ORIGINS=

# Optional: AI requests allowed per IP per 10 minutes (default: 12)
MT5_RATE_LIMIT=12

# Optional: Firebase project id used to verify sign-in tokens (default: trading-j-c9922)
FIREBASE_PROJECT_ID=trading-j-c9922
